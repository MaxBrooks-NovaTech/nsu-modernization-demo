# NSU BI Modernization Demo
# Copy this file to .env and replace placeholder values locally.
# Do not commit .env or real credentials.

# AI provider APIs
OPENAI_API_KEY=replace-with-openai-api-key
CLAUDE_API_KEY=replace-with-claude-api-key
GEMINI_API_KEY=replace-with-gemini-api-key

# Optional model defaults for automation or review helpers
OPENAI_MODEL=gpt-5
CLAUDE_MODEL=claude-sonnet-4
GEMINI_MODEL=gemini-2.5-pro

# GitHub automation
GITHUB_PAT=replace-with-github-personal-access-token
GITHUB_OWNER=MaxBrooks-NovaTech
GITHUB_REPO=nsu-modernization-demo

# Local PostgreSQL demonstration database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nsu_modernization_demo
POSTGRES_USER=nsu_demo_user
POSTGRES_PASSWORD=replace-with-local-demo-password

# dbt profile settings
DBT_PROFILES_DIR=./profiles
DBT_TARGET=dev
DBT_THREADS=4

# Synthetic data generation
SYNTHETIC_DATA_SEED=20260816
SYNTHETIC_DATA_OUTPUT_DIR=./seeds

# Optional Power BI / Microsoft Fabric placeholders
POWERBI_TENANT_ID=00000000-0000-0000-0000-000000000000
POWERBI_CLIENT_ID=00000000-0000-0000-0000-000000000000
POWERBI_CLIENT_SECRET=replace-with-powerbi-client-secret
POWERBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Optional Azure storage or data lake placeholders
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-azure-client-secret
AZURE_STORAGE_ACCOUNT=replace-with-storage-account
AZURE_STORAGE_CONTAINER=replace-with-storage-container

# Safety marker used by scripts to prevent accidental production usage
DEMO_DATA_ONLY=true
ALLOW_PRODUCTION_CONNECTIONS=false
