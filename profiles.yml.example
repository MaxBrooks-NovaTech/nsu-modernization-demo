nsu_modernization_demo:
  target: local
  outputs:
    local:
      type: postgres
      host: localhost
      port: "{{ env_var('POSTGRES_PORT', '5432') | as_number }}"
      user: nsu_demo_user
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: nsu_modernization_demo
      schema: analytics
      threads: 4
