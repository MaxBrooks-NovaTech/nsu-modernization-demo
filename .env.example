# NSU BI Modernization Demo
# Copy this file to .env and replace placeholder values locally.
# Do not commit .env or real credentials.

# AI provider APIs
openai-api-key=replace-with-openai-api-key
claude-api-key=replace-with-claude-api-key
gemini-api-key=replace-with-gemini-api-key

# Optional model defaults for automation or review helpers
openai-model=gpt-5
claude-model=claude-sonnet-4
gemini-model=gemini-2.5-pro

# GitHub automation
github-pat=replace-with-github-personal-access-token
github-owner=MaxBrooks-NovaTech
github-repo=nsu-modernization-demo

# Local PostgreSQL demonstration database
postgres-host=localhost
postgres-port=5432
postgres-db=nsu_modernization_demo
postgres-user=nsu_demo_user
postgres-password=replace-with-local-demo-password

# dbt profile settings
dbt-profiles-dir=./profiles
dbt-target=dev
dbt-threads=4

# Synthetic data generation
synthetic-data-seed=20260816
synthetic-data-output-dir=./seeds

# Optional Power BI / Microsoft Fabric placeholders
powerbi-tenant-id=00000000-0000-0000-0000-000000000000
powerbi-client-id=00000000-0000-0000-0000-000000000000
powerbi-client-secret=replace-with-powerbi-client-secret
powerbi-workspace-id=00000000-0000-0000-0000-000000000000

# Optional Azure storage or data lake placeholders
azure-tenant-id=00000000-0000-0000-0000-000000000000
azure-client-id=00000000-0000-0000-0000-000000000000
azure-client-secret=replace-with-azure-client-secret
azure-storage-account=replace-with-storage-account
azure-storage-container=replace-with-storage-container

# Safety marker used by scripts to prevent accidental production usage
demo-data-only=true
allow-production-connections=false
